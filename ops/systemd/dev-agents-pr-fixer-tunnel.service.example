[Unit]
Description=Cloudflare Tunnel for dev-agents GitHub PR fixer
Requires=dev-agents.service
After=dev-agents.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared --config %h/.cloudflared/codex-pr-review.yml tunnel run codex-pr-review
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
