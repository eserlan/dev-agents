[Unit]
Description=Daily dev-agents %i persona sweep

[Timer]
# Daily at a random time between 03:00 and 06:00 so personas do not start together.
# For a slower cadence for one persona, add a drop-in, e.g. for Bolt every third day:
#   systemctl --user edit dev-agents-sweep@bolt.timer
#   [Timer]
#   OnCalendar=
#   OnCalendar=*-*-01/3 03:00
OnCalendar=*-*-* 03:00
RandomizedDelaySec=3h
Persistent=true

[Install]
WantedBy=timers.target
